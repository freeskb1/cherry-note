rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 출산 준비노트 보안 규칙
// 이메일이 바뀌면 아래 ADMINS, LEGACY 만 고치면 돼요
//   ADMINS : 사용 중인 가족 목록을 볼 수 있는 관리자
//   LEGACY : 예전(공용) 기록을 쓰던 두 사람. 첫 로그인 때 자동으로 같은 가족으로 옮겨져요
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function ADMINS() { return ['freeskb@naver.com']; }
    function LEGACY() { return ['freeskb@naver.com', 'j-lush@naver.com']; }

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.email in ADMINS(); }
    function isLegacy() { return signedIn() && request.auth.token.email in LEGACY(); }
    function isMember(hid) {
      return signedIn() && hid is string
        && exists(/databases/$(database)/documents/households/$(hid))
        && uid() in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    // 이름·이메일 지도에서 내 칸만 바뀌었는지
    function onlyMyKeys(field) {
      return !(field in resource.data)
        ? request.resource.data[field].keys().hasOnly([uid()])
        : request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([uid()]);
    }
    // 1명뿐인 가족에 나 자신만 추가
    function addingOnlyMe() {
      return !(uid() in resource.data.members)
        && resource.data.members.size() == 1
        && request.resource.data.members == resource.data.members.concat([uid()])
        && onlyMyKeys('names') && onlyMyKeys('emails');
    }

    // 내 계정 정보 (어느 가족인지)
    match /users/{u} {
      allow read, write: if signedIn() && uid() == u;
    }

    // 가족: 멤버만 읽기. 최대 2명
    match /households/{hid} {
      allow get: if isMember(hid) || isAdmin();
      allow list: if isAdmin();   // 관리자: 사용 중인 가족 목록 (이름·이메일·가족 코드만)

      // 새 가족: 나 혼자 멤버로, 가족 코드도 같이 만들어야 함
      allow create: if signedIn()
        && request.resource.data.members == [uid()]
        && request.resource.data.keys().hasOnly(['members', 'names', 'emails', 'code', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == uid()
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.householdId == hid;

      allow update: if
        // 멤버: 내 이름만 수정
        (isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && onlyMyKeys('names'))
        // 배우자: 가족 코드로 자기 자신만 추가
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'emails', 'joinedVia'])
          && addingOnlyMe()
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedVia)).data.householdId == hid)
        // 광배·민주: 기존 기록을 옮긴 가족에 자동 합류
        || (isLegacy()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'emails'])
          && addingOnlyMe()
          && get(/databases/$(database)/documents/meta/migrated).data.householdId == hid);

      allow delete: if false;

      // 가족 안의 모든 목록·사진·설정: 멤버만
      match /{col}/{rest=**} {
        allow read, write: if isMember(hid);
      }
      // 관리자 목록에 태명 표시용
      match /meta/settings {
        allow get: if isAdmin();
      }
    }

    // 가족 코드 (6자리, 만료 없음. 가족이 2명이 되면 더 못 들어옴)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && uid() in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
      allow update, delete: if false;
    }

    // 새 가족이 받는 기본 데이터 (용품·신청 목록)
    match /templates/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 식후 측정 푸시 예약: 그 가족 멤버만
    match /alarms/{id} {
      allow read: if signedIn() && isMember(resource.data.householdId);
      allow create: if isMember(request.resource.data.householdId);
      allow update: if isMember(request.resource.data.householdId) && isMember(resource.data.householdId);
      allow delete: if signedIn() && (resource == null || isMember(resource.data.householdId));
    }

    // 폰별 푸시 토큰
    match /tokens/{id} {
      allow create, update: if isMember(request.resource.data.householdId) && request.resource.data.uid == uid();
      allow delete: if signedIn() && (resource == null || resource.data.uid == uid());
    }

    // 예전 공용 기록: 광배·민주만 읽기 (옮긴 뒤 지워도 됨)
    match /items/{d}  { allow read: if isLegacy(); }
    match /notes/{d}  { allow read: if isLegacy(); }
    match /admin/{d}  { allow read: if isLegacy(); }
    match /sugar/{d}  { allow read: if isLegacy(); }
    match /photos/{d} { allow read: if isLegacy(); }
    match /meta/{d}   { allow read, write: if isLegacy(); }
  }
}
