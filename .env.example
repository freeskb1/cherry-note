# ── 앱(브라우저)에서 쓰는 값: Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서 > 키 쌍(공개 키)
VITE_FIREBASE_VAPID_KEY=

# 로그인 이메일과 앱에 표시할 이름 (쉼표로 구분)
VITE_USER_NAMES=gwangbae@example.com:광배,minju@example.com:민주

# ── 서버(Vercel 함수)에서만 쓰는 값: Vercel 환경변수에만 넣기, VITE_ 붙이지 말 것 ──
# 서비스 계정 JSON 파일을 base64로 인코딩한 문자열
FIREBASE_SERVICE_ACCOUNT_B64=
# cron-job.org가 호출할 때 붙이는 비밀값 (아무 긴 문자열)
CRON_SECRET=
